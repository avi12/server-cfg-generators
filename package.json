{
  "name": "server-cfg-generators",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node -e \"require('fs').copyFileSync('dist/index.html', 'dist/404.html')\"",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint --fix",
    "stylelint": "stylelint \"src/**/*.{css,vue}\" --fix"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7",
    "vuetify": "^4.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/stylelint-plugin": "^5.1.0",
    "@types/node": "^25.9.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.3.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-newlines": "^2.0.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.11.1",
    "stylelint-config-ccb": "^3.31.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.13",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.9"
  }
}
